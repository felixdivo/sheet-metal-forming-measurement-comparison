// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
    "image": "mcr.microsoft.com/devcontainers/python:2-3.12-trixie",
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"ms-python.python",
				"charliermarsh.ruff",
				"Anthropic.claude-code"
			]
		}
	},
	"remoteEnv": {
		"LD_LIBRARY_PATH": "/usr/local/lib/python3.12/site-packages/nvidia/cusolver/lib:/usr/local/lib/python3.12/site-packages/nvidia/cufft/lib:/usr/local/lib/python3.12/site-packages/nvidia/cusparse/lib"
	},
	"postCreateCommand": "pip install -r requirements.txt",
	"remoteUser": "root",
	"runArgs": [
		// "--gpus", "\"device=05\""
		"--gpus", "all"
	]
}
